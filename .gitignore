# -----------------------------------------------------------------------------
# Rust, Python
# -----------------------------------------------------------------------------

# Environments
.venv

# -----------------------------------------------------------------------------
# Node (mermaid-cli, used by `prodockit pdf` to pre-render mermaid diagrams)
# -----------------------------------------------------------------------------
tools/mermaid/node_modules

# Intermediate .mmd/.svg files prodockit.pdf.mermaid writes while pre-
# rendering each ```mermaid fence for the PDF (see docs/section4.md's own
# diagram) - not build output itself, just scratch space.
docs/.prodockit-pdf-mermaid/

# -----------------------------------------------------------------------------
# Node (mathjax-full, used by `prodockit pdf` to pre-render TeX math)
# -----------------------------------------------------------------------------
tools/mathjax/node_modules

# Artifacts
/target
__pycache__
.pytest_cache
*.dll
*.so

# Tracing
trace.json

# -----------------------------------------------------------------------------
# Vale (fetched by `vale sync`, using the `Packages =` line in .vale.ini -
# not vendored, see prodockit-userguide#97)
# -----------------------------------------------------------------------------
styles/

# -----------------------------------------------------------------------------
# Citation style for prodockit.bibliography - fetched, not vendored (see
# CONTRIBUTING.md's "Getting set up" and prodockit-userguide#97)
# -----------------------------------------------------------------------------
/harvard-cite-them-right.csl

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Never ignore .gitkeep files
!**/.gitkeep

# macOS internals
.DS_Store
# The editor's own settings for this project. `prodockit bootstrap` writes
# .vscode/settings.json itself once the extensions it configures are
# installed, merging into whatever is already there rather than replacing
# it - and VS Code rewrites the file whenever a setting is changed in the
# UI. Tracking it would make every reader's own preferences show up as
# changes to the project (prodockit-template#188).
.vscode/


# Temporary files
tmp
.cache/
public/
docs/*.pdf
/source_bundle.pdf

# Local Claude Code config (dev-preview launch config, personal permissions)
.claude/

# Installed by `prodockit bootstrap` - third-party code and generated
# configuration, neither of which belongs in your repository. Copied from
# tools/mathjax's pinned install so the site and the PDF typeset through
# the same MathJax (prodockit-extensions#263).
docs/javascripts/vendor/
docs/javascripts/mathjax.js

# Font files, if you keep any here. Inter and JetBrains Mono - the two the
# PDF embeds - are installed on the machine rather than carried in the
# repository, the same as the MathJax bundle above: they are somebody
# else's files, often under licences that govern redistribution, and a
# repository is redistribution (prodockit-template#164).
fonts/
.prodockit-template.log

# Your own answers to `prodockit bootstrap`.
.pdk-bootstrap.toml
